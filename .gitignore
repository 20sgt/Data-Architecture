# raw landing zone (bronze) — never commit scraped data
raw/

# warehouse local artifacts
warehouse/db/
warehouse/exports/

# dev env / scratch
.env
.venv/
.probe/
logs/
*.log

# python
__pycache__/
*.pyc
.pytest_cache/

# os
.DS_Store

# slop
.claude

# dbt: throwaway build output, downloaded packages, logs, and the REAL
# connection file (holds a secret token — commit only profiles.yml.example)
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/profiles.yml
dbt/.env
dbt/.user.yml

# Terraform local artifacts (state lives in gs://cotc-tfstate; plans are throwaway)
terraform/.terraform/
terraform/tfplan*
*.tfstate
*.tfstate.*

# retired DuckDB-era artifacts (superseded by the Databricks lakehouse)
warehouse/

# podcast pipeline local artifacts
# NOTE: `*.json` is repo-wide, not scoped to sfchronicle_podcast_ingest/. Files
# already tracked (e.g. sample/**/*.json) are unaffected, but any NEW .json
# anywhere in the repo is now silently ignored — `git add` will appear to do
# nothing. Narrow this to the podcast directory if that bites.
*.json
!sfchronicle_podcast_ingest/data/representatives.json
sfchronicle_podcast_ingest/data/*.sqlite
sfchronicle_podcast_ingest/data/*.sqlite-*

# NL query app: downloaded transcripts, FTS index, schema cache
app/data/
