# Secrets for the NL query app (app/ask.py, app/streamlit_app.py).
# Copy to .env and fill in. .env is gitignored; this file must stay placeholders.
#
# Nothing loads .env automatically — export it into your shell first:
#     set -a; source .env; set +a
#     streamlit run app/streamlit_app.py

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=example_console_key_here

# Databricks -> SQL Warehouses -> your warehouse -> Connection details.
# HOST is the workspace hostname with no scheme (it matches databricks.yml).
DBT_DATABRICKS_HOST=8259559357598229.9.gcp.databricks.com
DBT_DATABRICKS_HTTP_PATH=example_DBT_DB_HTTP_PATH

# Databricks -> User Settings -> Developer -> Access tokens -> Generate.
# Scope "BI Tools": the SQL-warehouse endpoint is the only API this app calls.
DBT_DATABRICKS_TOKEN=example_dapi_token_here

# Optional — defaults to corn_off_the_cob in app/ask.py.
#DBT_DATABRICKS_CATALOG=corn_off_the_cob
